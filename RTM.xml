<?xml version="1.0" encoding="UTF-8"?>
<presets xmlns="http://josm.openstreetmap.de/tagging-preset-1.0"
         icon="https://rtm.erzeszow.pl/wp-content/uploads/2025/05/cropped-cropped-favicon_ZTM-02-32x32.png"
         description="Preset for Rzeszowski Transport Miejski - public transport network in Rzeszów."
         shortdescription="Rzeszowski Transport Miejski"
         author="Dawid2849, Paweł_M"
         version="0.2"
         baselanguage="English">
    <group name="Buses" pl.name="Autobusy">
        <item name="RTM Bus stop" pl.name="Przystanek RTM" icon="presets/transport/bus_small.svg" type="node">
            <link wiki="Tag:highway=bus_stop"/>
            <key key="highway" value="bus_stop"/>
            <key key="bus" value="yes"/>
            <key key="operator" value="Zarząd Transportu Miejskiego w Rzeszowie"/>
            <key key="operator:short" value="ZTM Rzeszów"/>
            <key key="operator:type" value="public"/>
            <key key="operator:wikidata" value="Q141755570"/>
            <key key="public_transport"/>  <!--For deleting public_transport=platform from nodes-->

            <text key="name" text="Bus Stop name" pl.text="Nazwa przystanku"/>
            <text key="ref" text="Stop ID" pl.text="Numer słupka"/>
            <text key="local_ref" text="Stop number" pl.text="Numer przystanku"/>
            <combo key="network" text="Networks" pl.text="Sieci"
                   values="Rzeszowski Transport Miejski,Rzeszowski Transport Miejski;Międzygminna Komunikacja Samochodowa"/>
            <combo key="network:short" text="Networks (short names)" pl.text="Sieci (skróty)" values="RTM,RTM;MKS"/>
            <combo key="network:wikidata" text="Network (Wikidata)" pl.text="Sieć (Wikidata)" values="Q141627938"
                   editable="false"/>
            <combo key="departures_board" text="Departures board" pl.text="Tablica z rozkładem jazdy"
                   values="timetable,timetable;realtime,no"/>
            <text key="route_ref" text="Route refs (RTM and MKS)" pl.text="Numery linii (RTM i MKS)"/>
            <combo key="zone:RTM" text="Zone (RTM)" pl.text="Strefa (RTM)" values="A,B" editable="false"/>

            <space/>
            <check key="passenger_information_display" text="Passenger information system"
                   pl.text="Tablica elektroniczna"/>
            <combo key="traffic_sign" text="Traffic sign" pl.text="Znak drogowy" editable="false">
                <list_entry value="PL:D-15" display_value="yes" pl.display_value="tak"/>
                <list_entry value="no" display_value="no" pl.display_value="nie"/>
            </combo>
            <combo key="pole" text="Pole" pl.text="Słupek" values="traffic_sign,totem,no" editable="false"/>
            <text key="website" text="Real-time timetable website" pl.text="Link do e-tablicy"/>

            <space/>
            <check key="check_date" text="Check date" pl.text="Data sprawdzenia"/>
            <check key="shelter" text="Shelter" pl.text="Wiata"/>
            <check key="covered" text="Covered (ex. shelter)" pl.text="Zadaszenie (poza wiatą)" default="off"/>
            <check key="bench" text="Bench" pl.text="Ławka"/>
            <check key="bin" text="Trash bin" pl.text="Śmietnik"/>
            <check key="lit" text="Lit" pl.text="Oświetlony"/>
            <check key="tactile_paving" text="Tactile paving" pl.text="Ścieżka dotykowa"/>
            <combo key="wheelchair" text="Wheelchair access" pl.text="Dostęp na wózku" values="yes,limited,no"
                   editable="false"/>

            <space/>
            <check key="request_stop" text="On demand" pl.text="Na żądanie"/>

            <space/>
            <text key="gtfs:stop_id" text="GTFS Stop ID"/>
            <text key="gtfs:stop_name" text="GTFS Stop Name"/>
        </item>

        <!--TODO: shelters, platforms, stop positions, routes, stop areas, bus bays, ticket vending machines, maybe sth else...-->

    </group>

    <separator/>

    <group name="Car parks" pl.name="Parkingi">
        <item name="TODO">
            <!--TODO: Paid car parks, parking ticket vending machines, maybe sth else...-->
        </item>
    </group>
</presets>
